{
  "name": "asset-manager-prototype",
  "version": "0.0.0",
  "description": "Asset manager for IMI",
  "author": "Alexander Ivanets aivanets@ukaachen.de",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter=web dev",
    "build": "bun run --filter='*' build",
    "test": "bun run --filter='*' test",
    "typecheck": "bun run --filter='*' typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
